#!/usr/bin/env bash
#
# sim — one command for iOS simulators and Android emulators.
#
#   sim                    interactive menu
#   sim ls                 list devices and their state
#   sim boot [name]        boot a device (Android resumes its quick-boot snapshot)
#   sim cold [name]        cold boot: full shutdown, then a fresh start
#   sim kill [name|all]    shut down a device, or everything
#   sim erase [name]       factory reset a device (asks for confirmation)
#   sim fav [name]         toggle a favorite (marked ★, listed first)
#   sim boot favs          boot every favorite (also works: cold favs, kill favs)
#   sim ls --json          machine-readable device list (for scripts and agents)
#   sim shot [name]        screenshot a booted device (to ~/Desktop, or --out <path>)
#   sim create ...         create a device: sim create ios|android <model> <os> [--name <n>]
#                          (interactive when run with no arguments)
#   sim rm <name|id>       delete a simulator/AVD permanently (asks first)
#   sim models [platform]  list creatable models and OS versions (--json)
#   sim update             pull the latest version and rebuild what changed
#   sim version            show the installed version
#   sim <name>             shorthand for `sim boot <name>`
#
# Names match loosely (case-insensitive, spaces/underscores/dashes ignored):
#   sim cold pixel9a
#   sim boot 16e

ANDROID_SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
EMULATOR="$ANDROID_SDK/emulator/emulator"
ADB="$ANDROID_SDK/platform-tools/adb"
[ -x "$ADB" ] || ADB="$(command -v adb 2>/dev/null)"

# avdmanager/sdkmanager live in cmdline-tools (inside the SDK, or via
# `brew install --cask android-commandlinetools`).
AVDMANAGER=""
for _p in "$ANDROID_SDK/cmdline-tools/latest/bin/avdmanager" \
          "$ANDROID_SDK/tools/bin/avdmanager" \
          /opt/homebrew/bin/avdmanager /usr/local/bin/avdmanager; do
  [ -x "$_p" ] && { AVDMANAGER="$_p"; break; }
done
SDKMANAGER=""
[ -n "$AVDMANAGER" ] && [ -x "$(dirname "$AVDMANAGER")/sdkmanager" ] \
  && SDKMANAGER="$(dirname "$AVDMANAGER")/sdkmanager"

# Favorites are shared with Simulators.app: one device id per line.
FAV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/sim/favorites"

is_fav() { [ -f "$FAV_FILE" ] && grep -qxF "$1" "$FAV_FILE"; }

if [ -t 1 ]; then
  GREEN=$'\033[32m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
else
  GREEN=""; DIM=""; BOLD=""; RESET=""
fi

die() { echo "sim: $*" >&2; exit 1; }

usage() {
  awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "$0"
}

# ---------------------------------------------------------------- inventory --
# Parallel arrays, one entry per device.
D_PLATFORM=(); D_NAME=(); D_ID=(); D_STATE=(); D_OS=(); D_SERIAL=()

load_ios() {
  command -v xcrun >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || { echo "sim: jq not found, skipping iOS simulators" >&2; return 0; }
  local rt name udid state os ver
  while IFS=$'\t' read -r rt name udid state; do
    rt="${rt##*.SimRuntime.}"          # iOS-26-2
    os="${rt%%-*}"; ver="${rt#*-}"; ver="${ver//-/.}"
    D_PLATFORM[${#D_PLATFORM[@]}]="ios"
    D_NAME[${#D_NAME[@]}]="$name"
    D_ID[${#D_ID[@]}]="$udid"
    D_STATE[${#D_STATE[@]}]="$state"
    D_OS[${#D_OS[@]}]="$os $ver"
    D_SERIAL[${#D_SERIAL[@]}]=""
  done < <(xcrun simctl list devices available --json 2>/dev/null \
    | jq -r '.devices | to_entries | sort_by(.key)[] | select(.key | test("iOS")) | .key as $rt
             | .value[] | [$rt, .name, .udid, .state] | @tsv')
}

load_android() {
  [ -x "$EMULATOR" ] || return 0
  local serials="" s n avd state serial i
  local run_serials=() run_names=()
  if [ -n "$ADB" ]; then
    serials="$("$ADB" devices 2>/dev/null | awk '/^emulator-/{print $1}')"
  fi
  for s in $serials; do
    n="$("$ADB" -s "$s" emu avd name 2>/dev/null | head -1 | tr -d '\r')"
    if [ -n "$n" ]; then
      run_serials[${#run_serials[@]}]="$s"
      run_names[${#run_names[@]}]="$n"
    fi
  done
  while IFS= read -r avd; do
    [ -n "$avd" ] || continue
    state="Shutdown"; serial=""; i=0
    for n in "${run_names[@]}"; do
      [ "$n" = "$avd" ] && { state="Booted"; serial="${run_serials[$i]}"; }
      i=$((i+1))
    done
    D_PLATFORM[${#D_PLATFORM[@]}]="android"
    D_NAME[${#D_NAME[@]}]="$avd"
    D_ID[${#D_ID[@]}]="$avd"
    D_STATE[${#D_STATE[@]}]="$state"
    D_OS[${#D_OS[@]}]="Android"
    D_SERIAL[${#D_SERIAL[@]}]="$serial"
  done < <("$EMULATOR" -list-avds 2>/dev/null | grep -E '^[A-Za-z0-9._-]+$')
}

load_all() {
  load_ios
  load_android
  [ ${#D_NAME[@]} -gt 0 ] || die "no iOS simulators or Android AVDs found"
  reorder_favorites
}

# Float favorites to the top of their platform group, preserving order otherwise.
reorder_favorites() {
  [ -s "$FAV_FILE" ] || return 0
  local order=() plat i
  for plat in ios android; do
    for ((i = 0; i < ${#D_NAME[@]}; i++)); do
      [ "${D_PLATFORM[$i]}" = "$plat" ] && is_fav "${D_ID[$i]}" && order[${#order[@]}]="$i"
    done
    for ((i = 0; i < ${#D_NAME[@]}; i++)); do
      [ "${D_PLATFORM[$i]}" = "$plat" ] && ! is_fav "${D_ID[$i]}" && order[${#order[@]}]="$i"
    done
  done
  local np=() nn=() nid=() nst=() nos=() nse=()
  for i in "${order[@]}"; do
    np[${#np[@]}]="${D_PLATFORM[$i]}"
    nn[${#nn[@]}]="${D_NAME[$i]}"
    nid[${#nid[@]}]="${D_ID[$i]}"
    nst[${#nst[@]}]="${D_STATE[$i]}"
    nos[${#nos[@]}]="${D_OS[$i]}"
    nse[${#nse[@]}]="${D_SERIAL[$i]}"
  done
  D_PLATFORM=("${np[@]}"); D_NAME=("${nn[@]}"); D_ID=("${nid[@]}")
  D_STATE=("${nst[@]}"); D_OS=("${nos[@]}"); D_SERIAL=("${nse[@]}")
}

# ------------------------------------------------------------------ display --
device_line() { # index
  local i=$1 dot="${DIM}○ off${RESET}" star="  "
  [ "${D_STATE[$i]}" = "Booted" ] && dot="${GREEN}● booted${RESET}"
  is_fav "${D_ID[$i]}" && star="★ "
  printf "%s%-28s %-11s %s" "$star" "${D_NAME[$i]}" "${D_OS[$i]}" "$dot"
}

print_devices() {
  local i last=""
  for ((i = 0; i < ${#D_NAME[@]}; i++)); do
    if [ "${D_PLATFORM[$i]}" != "$last" ]; then
      last="${D_PLATFORM[$i]}"
      [ "$last" = "ios" ] && echo "${BOLD}iOS simulators${RESET}" || echo "${BOLD}Android emulators${RESET}"
    fi
    printf "  %2d) %s\n" "$((i + 1))" "$(device_line "$i")"
  done
}

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

print_json() {
  local i sep="" state fav serial
  printf '{"devices":['
  for ((i = 0; i < ${#D_NAME[@]}; i++)); do
    state="off"; [ "${D_STATE[$i]}" = "Booted" ] && state="booted"
    fav=false; is_fav "${D_ID[$i]}" && fav=true
    serial=null; [ -n "${D_SERIAL[$i]}" ] && serial="\"${D_SERIAL[$i]}\""
    printf '%s{"platform":"%s","name":"%s","id":"%s","os":"%s","state":"%s","favorite":%s,"serial":%s}' \
      "$sep" "${D_PLATFORM[$i]}" "$(json_escape "${D_NAME[$i]}")" "${D_ID[$i]}" \
      "${D_OS[$i]}" "$state" "$fav" "$serial"
    sep=","
  done
  printf ']}\n'
}

# ---------------------------------------------------------------- selection --
norm() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d ' _-'; }

find_matches() { # query -> MATCHES=(indices)
  local q i; MATCHES=()
  # An exact id (simulator UDID or AVD name) wins outright, so scripts and
  # agents can address a device unambiguously.
  for ((i = 0; i < ${#D_NAME[@]}; i++)); do
    if [ "$1" = "${D_ID[$i]}" ]; then MATCHES=("$i"); return; fi
  done
  q="$(norm "$1")"
  for ((i = 0; i < ${#D_NAME[@]}; i++)); do
    case "$(norm "${D_NAME[$i]}")" in
      *"$q"*) MATCHES[${#MATCHES[@]}]="$i" ;;
    esac
  done
}

read_number() { # max -> echoes choice-1, or "q" if the user quit
  local c
  printf "Device number (q to quit): " >&2
  read -r c
  case "$c" in q | Q | "") echo q; return 0 ;; esac
  printf '%s' "$c" | grep -qE '^[0-9]+$' || die "not a number: $c"
  { [ "$c" -ge 1 ] && [ "$c" -le "$1" ]; } || die "out of range: $c"
  echo $((c - 1))
}

choose_from() { # indices... -> sets SEL
  local n=1 i pick
  for i in "$@"; do
    printf "  %2d) %s\n" "$n" "$(device_line "$i")"
    n=$((n + 1))
  done
  pick="$(read_number $#)" || exit 1
  [ "$pick" = "q" ] && exit 0
  shift "$pick"
  SEL="$1"
}

resolve() { # [query...] -> sets SEL
  if [ $# -gt 0 ] && [ -n "$*" ]; then
    find_matches "$*"
    case ${#MATCHES[@]} in
      0) die "no device matching '$*' (see 'sim ls')" ;;
      1) SEL="${MATCHES[0]}" ;;
      *)
        echo "Multiple devices match '$*':"
        if [ -t 0 ]; then
          choose_from "${MATCHES[@]}"
        else
          local i
          for i in "${MATCHES[@]}"; do printf "  %s  id=%s\n" "$(device_line "$i")" "${D_ID[$i]}"; done
          die "ambiguous name — pass the exact id (see 'sim ls --json')"
        fi
        ;;
    esac
  else
    print_devices
    echo
    SEL="$(read_number ${#D_NAME[@]})" || exit 1
    [ "$SEL" = "q" ] && exit 0
  fi
}

# ------------------------------------------------------------------ actions --
launch_avd() { # avd [extra emulator flags...]
  local avd="$1"; shift
  nohup "$EMULATOR" -avd "$avd" "$@" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

wait_gone() { # serial — wait for an emulator to disappear from adb
  local s="$1" t=0
  while "$ADB" devices 2>/dev/null | grep -q "^$s[[:space:]]"; do
    sleep 1
    t=$((t + 1))
    [ $t -ge 20 ] && { echo "  (still shutting down, continuing anyway...)"; break; }
  done
}

do_boot() { # index
  local i=$1
  if [ "${D_PLATFORM[$i]}" = "ios" ]; then
    if [ "${D_STATE[$i]}" = "Booted" ]; then
      echo "${D_NAME[$i]} is already booted — bringing Simulator to the front."
    else
      echo "Booting ${D_NAME[$i]} (${D_OS[$i]})..."
      xcrun simctl boot "${D_ID[$i]}"
    fi
    open -a Simulator
  else
    if [ "${D_STATE[$i]}" = "Booted" ]; then
      echo "${D_NAME[$i]} is already running."
    else
      echo "Booting ${D_NAME[$i]} (resumes snapshot; use 'sim cold' for a fresh boot)..."
      launch_avd "${D_ID[$i]}"
    fi
  fi
}

do_cold() { # index
  local i=$1
  echo "Cold-booting ${D_NAME[$i]}..."
  if [ "${D_PLATFORM[$i]}" = "ios" ]; then
    xcrun simctl shutdown "${D_ID[$i]}" >/dev/null 2>&1
    xcrun simctl boot "${D_ID[$i]}"
    open -a Simulator
  else
    if [ -n "${D_SERIAL[$i]}" ]; then
      "$ADB" -s "${D_SERIAL[$i]}" emu kill >/dev/null 2>&1
      wait_gone "${D_SERIAL[$i]}"
    fi
    launch_avd "${D_ID[$i]}" -no-snapshot-load
  fi
}

do_kill() { # index
  local i=$1
  if [ "${D_STATE[$i]}" != "Booted" ]; then
    echo "${D_NAME[$i]} is not running."
    return 0
  fi
  echo "Shutting down ${D_NAME[$i]}..."
  if [ "${D_PLATFORM[$i]}" = "ios" ]; then
    xcrun simctl shutdown "${D_ID[$i]}" >/dev/null 2>&1
  else
    "$ADB" -s "${D_SERIAL[$i]}" emu kill >/dev/null 2>&1
    wait_gone "${D_SERIAL[$i]}"
  fi
}

kill_all() {
  echo "Shutting down all iOS simulators..."
  xcrun simctl shutdown all >/dev/null 2>&1
  if [ -n "$ADB" ]; then
    local s
    for s in $("$ADB" devices 2>/dev/null | awk '/^emulator-/{print $1}'); do
      echo "Shutting down $s..."
      "$ADB" -s "$s" emu kill >/dev/null 2>&1
    done
  fi
}

do_erase() { # index
  local i=$1 ans
  printf "Factory-reset %s? This deletes all of its data. [y/N] " "${D_NAME[$i]}"
  read -r ans
  case "$ans" in y | Y | yes) ;; *) echo "Cancelled."; return 0 ;; esac
  if [ "${D_PLATFORM[$i]}" = "ios" ]; then
    xcrun simctl shutdown "${D_ID[$i]}" >/dev/null 2>&1
    xcrun simctl erase "${D_ID[$i]}"
    echo "Erased. Use 'sim boot ${D_NAME[$i]}' to start it fresh."
  else
    if [ -n "${D_SERIAL[$i]}" ]; then
      "$ADB" -s "${D_SERIAL[$i]}" emu kill >/dev/null 2>&1
      wait_gone "${D_SERIAL[$i]}"
    fi
    echo "Wiping ${D_NAME[$i]} and booting it fresh..."
    launch_avd "${D_ID[$i]}" -wipe-data -no-snapshot-load
  fi
}

do_favs() { # action-fn — run an action on every favorite
  local fn=$1 i found=0
  for ((i = 0; i < ${#D_NAME[@]}; i++)); do
    if is_fav "${D_ID[$i]}"; then found=1; "$fn" "$i"; fi
  done
  [ $found -eq 1 ] || die "no favorites yet — add one with 'sim fav <name>'"
}

toggle_fav() { # index
  local id="${D_ID[$1]}" name="${D_NAME[$1]}"
  mkdir -p "$(dirname "$FAV_FILE")"
  touch "$FAV_FILE"
  if grep -qxF "$id" "$FAV_FILE"; then
    grep -vxF "$id" "$FAV_FILE" > "$FAV_FILE.tmp" && mv "$FAV_FILE.tmp" "$FAV_FILE"
    echo "Removed $name from favorites."
  else
    printf '%s\n' "$id" >> "$FAV_FILE"
    echo "Added ★ $name to favorites."
  fi
}

# ------------------------------------------------------------ create/rm/shot --
parse_flags() { # sets NAME_FLAG, OUT_FLAG, POS=(positional args)
  NAME_FLAG=""; OUT_FLAG=""; POS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) shift; NAME_FLAG="${1:-}" ;;
      --name=*) NAME_FLAG="${1#--name=}" ;;
      --out) shift; OUT_FLAG="${1:-}" ;;
      --out=*) OUT_FLAG="${1#--out=}" ;;
      *) POS[${#POS[@]}]="$1" ;;
    esac
    shift
  done
}

# Pick one entry from a named array by loose match: exact (normalized) wins,
# unique substring wins, otherwise a numbered picker (tty) or an error
# listing the candidates (non-tty). Echoes the chosen index.
match_pick() { # arrayname label [query]
  local arr=$1 label=$2 q="${3:-}" count i name c
  eval "count=\${#${arr}[@]}"
  [ "$count" -gt 0 ] || die "no $label options found"
  local cand=()
  if [ -n "$q" ]; then
    local nq; nq="$(norm "$q")"
    for ((i = 0; i < count; i++)); do
      eval "name=\${${arr}[$i]}"
      [ "$(norm "$name")" = "$nq" ] && { echo "$i"; return 0; }
    done
    for ((i = 0; i < count; i++)); do
      eval "name=\${${arr}[$i]}"
      case "$(norm "$name")" in *"$nq"*) cand[${#cand[@]}]="$i" ;; esac
    done
    [ ${#cand[@]} -eq 1 ] && { echo "${cand[0]}"; return 0; }
    if [ ${#cand[@]} -eq 0 ]; then
      [ -t 0 ] || die "no $label matching '$q' (see 'sim models')"
      echo "No $label matching '$q' — pick one:" >&2
      for ((i = 0; i < count; i++)); do cand[${#cand[@]}]="$i"; done
    fi
  else
    [ -t 0 ] || die "missing $label (see 'sim models')"
    for ((i = 0; i < count; i++)); do cand[${#cand[@]}]="$i"; done
  fi
  if [ ! -t 0 ]; then
    for i in "${cand[@]}"; do eval "name=\${${arr}[$i]}"; echo "  $name" >&2; done
    die "ambiguous $label '$q' — be more specific"
  fi
  local n=1
  for i in "${cand[@]}"; do
    eval "name=\${${arr}[$i]}"
    printf "  %2d) %s\n" "$n" "$name" >&2
    n=$((n + 1))
  done
  printf "Pick a %s (1-%d): " "$label" "${#cand[@]}" >&2
  read -r c
  printf '%s' "$c" | grep -qE '^[0-9]+$' || die "not a number: $c"
  { [ "$c" -ge 1 ] && [ "$c" -le ${#cand[@]} ]; } || die "out of range: $c"
  echo "${cand[$((c - 1))]}"
}

installed_images() { # echoes installed system image ids, one per line
  local d
  for d in "$ANDROID_SDK"/system-images/*/*/*/; do
    [ -d "$d" ] || continue
    printf '%s\n' "${d%/}" | sed "s|^$ANDROID_SDK/||; s|/|;|g"
  done
}

models_ios() { # 1=json
  local dts rts
  dts="$(xcrun simctl list devicetypes --json | jq '[.devicetypes[]
    | select(.productFamily == "iPhone" or .productFamily == "iPad")
    | {name, id: .identifier}]')"
  rts="$(xcrun simctl list runtimes --json | jq '[.runtimes[]
    | select(.isAvailable and (.name | startswith("iOS")))
    | {name, id: .identifier}]')"
  if [ "${1:-0}" = "1" ]; then
    jq -n --argjson m "$dts" --argjson r "$rts" \
      '{platform: "ios", models: $m, os_versions: $r}'
  else
    echo "${BOLD}iOS device models${RESET}"
    printf '%s' "$dts" | jq -r '.[].name' | sed 's/^/  /'
    echo "${BOLD}iOS versions${RESET}"
    printf '%s' "$rts" | jq -r '.[].name' | sed 's/^/  /'
  fi
}

models_android() { # 1=json
  [ -n "$AVDMANAGER" ] || die "avdmanager not found — install it with: brew install --cask android-commandlinetools"
  local defs imgs
  defs="$(ANDROID_HOME="$ANDROID_SDK" "$AVDMANAGER" list device -c 2>/dev/null | grep -E '^[A-Za-z0-9._ -]+$')"
  imgs="$(installed_images)"
  if [ "${1:-0}" = "1" ]; then
    jq -n \
      --argjson m "$(printf '%s' "$defs" | jq -R -s 'split("\n") | map(select(length > 0))')" \
      --argjson i "$(printf '%s' "$imgs" | jq -R -s 'split("\n") | map(select(length > 0))')" \
      '{platform: "android", models: $m, images_installed: $i,
        note: "an API level (e.g. 36) picks an installed image; other images are downloaded via sdkmanager"}'
  else
    echo "${BOLD}Android device definitions${RESET}"
    printf '%s\n' "$defs" | sed 's/^/  /'
    echo "${BOLD}Installed system images${RESET}"
    printf '%s\n' "$imgs" | sed 's/^/  /'
  fi
}

create_ios() {
  parse_flags "$@"
  CT_NAMES=(); CT_IDS=(); RT_NAMES=(); RT_IDS=()
  local n i
  while IFS=$'\t' read -r n i; do
    CT_NAMES[${#CT_NAMES[@]}]="$n"; CT_IDS[${#CT_IDS[@]}]="$i"
  done < <(xcrun simctl list devicetypes --json | jq -r '.devicetypes[]
    | select(.productFamily == "iPhone" or .productFamily == "iPad")
    | [.name, .identifier] | @tsv')
  while IFS=$'\t' read -r n i; do
    RT_NAMES[${#RT_NAMES[@]}]="$n"; RT_IDS[${#RT_IDS[@]}]="$i"
  done < <(xcrun simctl list runtimes --json | jq -r '.runtimes[]
    | select(.isAvailable and (.name | startswith("iOS")))
    | [.name, .identifier] | @tsv')
  local di ri
  di="$(match_pick CT_NAMES "device model" "${POS[0]:-}")" || exit 1
  ri="$(match_pick RT_NAMES "iOS version" "${POS[1]:-}")" || exit 1
  local name="${NAME_FLAG:-${CT_NAMES[$di]}}" udid
  echo "Creating '$name' (${CT_NAMES[$di]}, ${RT_NAMES[$ri]})..."
  udid="$(xcrun simctl create "$name" "${CT_IDS[$di]}" "${RT_IDS[$ri]}")" || die "simctl create failed"
  echo "✓ Created $name ($udid) — boot it with: sim boot '$name'"
}

# avdmanager only sees system images when it lives INSIDE the SDK (it derives
# the SDK root from its own path and ignores ANDROID_HOME). If we only have an
# external copy (e.g. Homebrew's), use its sdkmanager to install cmdline-tools
# into the SDK proper — the layout Google documents.
ensure_sdk_cmdline_tools() {
  case "$AVDMANAGER" in "$ANDROID_SDK"/*) return 0 ;; esac
  [ -n "$SDKMANAGER" ] || die "avdmanager not found — install it with: brew install --cask android-commandlinetools"
  echo "Installing cmdline-tools into the Android SDK (one-time, ~150MB)..."
  yes | "$SDKMANAGER" --sdk_root="$ANDROID_SDK" "cmdline-tools;latest" >/dev/null \
    || die "cmdline-tools install failed"
  AVDMANAGER="$ANDROID_SDK/cmdline-tools/latest/bin/avdmanager"
  SDKMANAGER="$ANDROID_SDK/cmdline-tools/latest/bin/sdkmanager"
  [ -x "$AVDMANAGER" ] || die "cmdline-tools install didn't produce avdmanager"
}

create_android() {
  ensure_sdk_cmdline_tools
  parse_flags "$@"
  DD_IDS=(); IMG_IDS=()
  local d
  while IFS= read -r d; do
    [ -n "$d" ] && DD_IDS[${#DD_IDS[@]}]="$d"
  done < <(ANDROID_HOME="$ANDROID_SDK" "$AVDMANAGER" list device -c 2>/dev/null | grep -E '^[A-Za-z0-9._ -]+$')
  while IFS= read -r d; do
    [ -n "$d" ] && IMG_IDS[${#IMG_IDS[@]}]="$d"
  done < <(installed_images)

  local di image="" ii imgq="${POS[1]:-}"
  di="$(match_pick DD_IDS "device definition" "${POS[0]:-}")" || exit 1
  case "$imgq" in
    system-images\;*) image="$imgq" ;;  # full image id, may need a download
    *)
      # A bare API level matches an installed image for that exact level.
      if printf '%s' "$imgq" | grep -qE '^[0-9]+$'; then
        for d in "${IMG_IDS[@]}"; do
          case "$d" in *";android-$imgq;"*) image="$d"; break ;; esac
        done
      fi
      if [ -z "$image" ]; then
        ii="$(match_pick IMG_IDS "system image" "$imgq")" || exit 1
        image="${IMG_IDS[$ii]}"
      fi
      ;;
  esac

  if [ ! -d "$ANDROID_SDK/$(printf '%s' "$image" | tr ';' '/')" ]; then
    [ -n "$SDKMANAGER" ] || die "sdkmanager not found — can't download $image"
    echo "Downloading $image (this can take several minutes)..."
    yes | ANDROID_HOME="$ANDROID_SDK" "$SDKMANAGER" --sdk_root="$ANDROID_SDK" "$image" \
      || die "download of $image failed"
  fi

  local name="$NAME_FLAG"
  if [ -z "$name" ]; then
    local api
    api="$(printf '%s' "$image" | sed 's/.*android-\([0-9.]*\).*/\1/')"
    name="$(printf '%s' "${DD_IDS[$di]}" | sed 's/[^A-Za-z0-9._-]/_/g')_API_${api}"
  fi
  echo "Creating '$name' (${DD_IDS[$di]}, $image)..."
  # avdmanager prints harmless "Could not load devices.xml" noise on stderr;
  # surface stderr only when the create actually fails.
  local errout
  errout="$(echo no | ANDROID_HOME="$ANDROID_SDK" ANDROID_SDK_ROOT="$ANDROID_SDK" \
    "$AVDMANAGER" create avd -n "$name" -k "$image" -d "${DD_IDS[$di]}" 2>&1 >/dev/null)" \
    || { printf '%s\n' "$errout" >&2; die "avdmanager create failed"; }
  echo "✓ Created $name — boot it with: sim boot $name"
}

cmd_create() {
  local plat="${1:-}"
  case "$plat" in
    ios | android) shift ;;
    "")
      [ -t 0 ] || die "usage: sim create ios|android <model> <os> [--name <name>]"
      printf "Platform — (i)OS or (a)ndroid: "
      local p; read -r p
      case "$p" in i | ios | iOS) plat=ios ;; a | android) plat=android ;; *) die "unknown platform '$p'" ;; esac
      ;;
    *) die "unknown platform '$plat' (expected ios or android)" ;;
  esac
  [ "$plat" = "ios" ] && create_ios "$@" || create_android "$@"
}

do_rm() { # index
  local i=$1 ans
  printf "Delete %s permanently? This cannot be undone. [y/N] " "${D_NAME[$i]}"
  read -r ans
  case "$ans" in y | Y | yes) ;; *) echo "Cancelled."; return 0 ;; esac
  if [ "${D_PLATFORM[$i]}" = "ios" ]; then
    xcrun simctl shutdown "${D_ID[$i]}" >/dev/null 2>&1
    xcrun simctl delete "${D_ID[$i]}" || die "simctl delete failed"
  else
    if [ -n "${D_SERIAL[$i]}" ]; then
      "$ADB" -s "${D_SERIAL[$i]}" emu kill >/dev/null 2>&1
      wait_gone "${D_SERIAL[$i]}"
    fi
    if [ -n "$AVDMANAGER" ]; then
      ANDROID_HOME="$ANDROID_SDK" "$AVDMANAGER" delete avd -n "${D_ID[$i]}" >/dev/null \
        || die "avdmanager delete failed"
    else
      rm -rf "$HOME/.android/avd/${D_ID[$i]}.avd" "$HOME/.android/avd/${D_ID[$i]}.ini"
    fi
  fi
  if [ -f "$FAV_FILE" ] && grep -qxF "${D_ID[$i]}" "$FAV_FILE"; then
    grep -vxF "${D_ID[$i]}" "$FAV_FILE" > "$FAV_FILE.tmp" && mv "$FAV_FILE.tmp" "$FAV_FILE"
  fi
  echo "Deleted ${D_NAME[$i]}."
}

pick_booted() { # sets SEL to the only booted device, or asks/errors
  local idxs=() i
  for ((i = 0; i < ${#D_NAME[@]}; i++)); do
    [ "${D_STATE[$i]}" = "Booted" ] && idxs[${#idxs[@]}]="$i"
  done
  case ${#idxs[@]} in
    0) die "nothing is booted" ;;
    1) SEL="${idxs[0]}" ;;
    *)
      if [ -t 0 ]; then
        echo "Multiple devices are booted:"
        choose_from "${idxs[@]}"
      else
        for i in "${idxs[@]}"; do printf "  %s  id=%s\n" "$(device_line "$i")" "${D_ID[$i]}" >&2; done
        die "multiple devices are booted — name one"
      fi
      ;;
  esac
}

resolve_shot() { # [query...] -> sets SEL; prefers booted devices on ambiguity
  if [ $# -gt 0 ] && [ -n "$*" ]; then
    find_matches "$*"
    if [ ${#MATCHES[@]} -gt 1 ]; then
      local booted=() i
      for i in "${MATCHES[@]}"; do
        [ "${D_STATE[$i]}" = "Booted" ] && booted[${#booted[@]}]="$i"
      done
      # Only booted devices can be screenshotted, so a unique booted match
      # settles the ambiguity; multiple booted matches narrow the choices.
      [ ${#booted[@]} -ge 1 ] && MATCHES=("${booted[@]}")
    fi
    case ${#MATCHES[@]} in
      0) die "no device matching '$*' (see 'sim ls')" ;;
      1) SEL="${MATCHES[0]}" ;;
      *)
        echo "Multiple booted devices match '$*':"
        if [ -t 0 ]; then
          choose_from "${MATCHES[@]}"
        else
          local i
          for i in "${MATCHES[@]}"; do printf "  %s  id=%s\n" "$(device_line "$i")" "${D_ID[$i]}" >&2; done
          die "ambiguous name — pass the exact id (see 'sim ls --json')"
        fi
        ;;
    esac
  else
    pick_booted
  fi
}

do_shot() { # index [outpath] — echoes the written path
  local i=$1 out="${2:-}"
  [ "${D_STATE[$i]}" = "Booted" ] || die "${D_NAME[$i]} is not booted"
  if [ -z "$out" ]; then
    local safe
    safe="$(printf '%s' "${D_NAME[$i]}" | sed 's/[^A-Za-z0-9._-]/-/g')"
    out="$HOME/Desktop/sim-$safe-$(date +%Y%m%d-%H%M%S).png"
  fi
  if [ "${D_PLATFORM[$i]}" = "ios" ]; then
    xcrun simctl io "${D_ID[$i]}" screenshot "$out" >/dev/null 2>&1 || die "screenshot failed"
  else
    "$ADB" -s "${D_SERIAL[$i]}" exec-out screencap -p > "$out" || die "screenshot failed"
  fi
  echo "$out"
}

repo_dir() {
  # The CLI is a symlink into the git clone, so resolving our own path
  # finds the repo — that's what makes `sim update` possible.
  local script
  script="$(readlink -f "$0")" || die "can't resolve script path"
  dirname "$script"
}

do_version() {
  git -C "$(repo_dir)" describe --tags --always 2>/dev/null \
    || echo "unknown (not a git checkout)"
}

do_update() {
  local repo old new was_running=0
  # When triggered from the app, we inherit the minimal GUI PATH — make
  # sure Homebrew tools (npm) are reachable.
  PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
  repo="$(repo_dir)"
  git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "$repo is not a git checkout — reinstall from https://github.com/rialdana/simulators"
  old="$(git -C "$repo" rev-parse HEAD)"
  echo "Updating $repo..."
  git -C "$repo" pull --ff-only >/dev/null || die "git pull failed — resolve local changes in $repo and retry"
  new="$(git -C "$repo" rev-parse HEAD)"
  if [ "$old" = "$new" ]; then
    echo "Already up to date ($(do_version))."
    return 0
  fi
  echo
  echo "Changes:"
  git -C "$repo" log --oneline "$old..$new" | sed 's/^/  /'
  echo
  # The CLI and MCP server run straight out of the clone, so they're already
  # updated by the pull. Rebuild the rest only if it changed.
  if git -C "$repo" diff --name-only "$old" "$new" -- mcp/package.json | grep -q .; then
    echo "Updating MCP server dependencies..."
    (cd "$repo/mcp" && npm install --silent)
  fi
  if git -C "$repo" diff --name-only "$old" "$new" -- app/ | grep -q .; then
    pgrep -xq Simulators && was_running=1
    "$repo/app/build.sh"
    if [ "$was_running" -eq 1 ]; then
      open /Applications/Simulators.app 2>/dev/null || open "$HOME/Applications/Simulators.app"
    fi
  else
    echo "App unchanged — no rebuild needed."
  fi
  echo "✓ Updated to $(do_version)."
}

# -------------------------------------------------------------- interactive --
interactive() {
  print_devices
  echo
  SEL="$(read_number ${#D_NAME[@]})" || exit 1
  [ "$SEL" = "q" ] && exit 0
  local a
  printf "Action: (b)oot  (c)old boot  (k)ill  (e)rase  (f)avorite  [b]: "
  read -r a
  case "$a" in
    "" | b | boot) do_boot "$SEL" ;;
    c | cold) do_cold "$SEL" ;;
    k | kill | s) do_kill "$SEL" ;;
    e | erase) do_erase "$SEL" ;;
    f | fav) toggle_fav "$SEL" ;;
    q | Q) exit 0 ;;
    *) die "unknown action '$a'" ;;
  esac
}

# ----------------------------------------------------------------- dispatch --
main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    "" | menu)
      load_all; interactive ;;
    ls | list | status)
      load_all
      if [ "${1:-}" = "--json" ]; then print_json; else print_devices; fi ;;
    boot | start | launch)
      load_all
      case "${1:-}" in
        favs | favorites) do_favs do_boot ;;
        *) resolve "$@"; do_boot "$SEL" ;;
      esac ;;
    cold | restart | reboot)
      load_all
      case "${1:-}" in
        favs | favorites) do_favs do_cold ;;
        *) resolve "$@"; do_cold "$SEL" ;;
      esac ;;
    kill | shutdown | stop | down)
      load_all
      case "${1:-}" in
        all) kill_all ;;
        favs | favorites) do_favs do_kill ;;
        *) resolve "$@"; do_kill "$SEL" ;;
      esac ;;
    erase | wipe | reset)
      load_all; resolve "$@"; do_erase "$SEL" ;;
    fav | favorite | star | unfav)
      load_all; resolve "$@"; toggle_fav "$SEL" ;;
    shot | screenshot)
      load_all
      parse_flags "$@"
      resolve_shot ${POS[@]+"${POS[@]}"}
      do_shot "$SEL" "$OUT_FLAG" ;;
    create | new)
      cmd_create "$@" ;;
    rm | remove)
      load_all; resolve "$@"; do_rm "$SEL" ;;
    models)
      case "${1:-}" in
        ios) models_ios "$([ "${2:-}" = "--json" ] && echo 1 || echo 0)" ;;
        android) models_android "$([ "${2:-}" = "--json" ] && echo 1 || echo 0)" ;;
        "") models_ios 0; echo; models_android 0 ;;
        *) die "usage: sim models [ios|android] [--json]" ;;
      esac ;;
    update | upgrade)
      do_update ;;
    version | -v | --version)
      do_version ;;
    -h | --help | help)
      usage ;;
    *)
      # Anything else is treated as a device name: `sim pixel9a` boots it.
      load_all
      find_matches "$cmd $*"
      [ ${#MATCHES[@]} -gt 0 ] || die "unknown command or device '$cmd' (try 'sim help')"
      resolve "$cmd" "$@"
      do_boot "$SEL" ;;
  esac
}

main "$@"
